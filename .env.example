# Ruta del fichero SQLite del tablón de retos
DATABASE_PATH=./data/hub.db

# --- Autenticación ---
# Producción: la app está detrás de un proxy que autentica (oauth2-proxy, Cloudflare Access...)
# y añade el email del usuario en una cabecera. Activar SOLO si la app no es accesible
# sin pasar por ese proxy: la cabecera se acepta tal cual.
TRUST_PROXY_AUTH=false
AUTH_EMAIL_HEADER=x-forwarded-email
# Emails con rol admin (separados por comas)
ADMIN_EMAILS=

# Solo desarrollo local: usuario falso sin proxy. NUNCA en un despliegue accesible por la red.
ALLOW_DEV_USER=false
DEV_USER_EMAIL=dev@example.org
DEV_USER_ADMIN=true

HOST=0.0.0.0
PORT=4321
