---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Track from '../components/Track.astro';
import { site } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = site.tagline } = Astro.props;
const demo = import.meta.env.PUBLIC_DEMO === 'true';
const fullTitle = title ? `${title} · ${site.name}` : site.name;
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <title>{fullTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Aplica el tema antes del primer pintado para evitar parpadeo.
      (function () {
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') {
          t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {demo && (
      <div class="demo-banner">
        Static demo with sample content. The challenge board, exceptions, metrics and admin need the server version:{' '}
        <a href={site.repo}>get it on GitHub</a>.
      </div>
    )}
    <Header currentPath={Astro.url.pathname} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {!demo && <Track />}
  </body>
</html>
