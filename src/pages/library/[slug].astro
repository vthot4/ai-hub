---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CodeCopy from '../../components/CodeCopy.astro';
import MermaidRender from '../../components/MermaidRender.astro';
import { getLibrary } from '../../lib/catalog';
import { libraryTypeLabel, fmtDate } from '../../lib/labels';

export async function getStaticPaths() {
  return (await getLibrary()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
---
<Base title={d.title} description={d.summary}>
  <div class="container" style="padding-top:2.5rem;max-width:820px">
    <p class="crumbs"><a href="/library/">Library</a> / {d.title}</p>
    <p class="eyebrow">{libraryTypeLabel[d.type]} · {d.category}</p>
    <h1 style="font-size:clamp(2rem,4vw,2.7rem)"><span aria-hidden="true">{d.icon}</span> {d.title}</h1>
    <p class="muted" style="margin:.8rem 0 .6rem;font-size:1.08rem">{d.summary}</p>
    <p class="tag" style="margin-bottom:2rem">{d.author} · {fmtDate(d.publishedOn)}</p>
    <div class="prose"><Content /></div>
  </div>
  <CodeCopy />
  <MermaidRender />
</Base>
