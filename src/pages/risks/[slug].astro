---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CodeCopy from '../../components/CodeCopy.astro';
import { getRisks } from '../../lib/catalog';
import { severityLabel, riskStatusLabel, fmtDate } from '../../lib/labels';

export async function getStaticPaths() {
  return (await getRisks()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const sev = severityLabel[d.severity];
const st = riskStatusLabel[d.status];
const { Content } = await render(entry);
---
<Base title={d.title} description={d.summary}>
  <div class="container" style="padding-top:2.5rem">
    <p class="crumbs"><a href="/risks/">Risks</a> / {d.title}</p>
    <div class="detail">
      <div>
        <p class="eyebrow">{d.category}</p>
        <h1 style="font-size:clamp(2rem,4vw,2.7rem)"><span aria-hidden="true">{d.icon}</span> {d.title}</h1>
        <p class="muted" style="margin:.8rem 0 1.2rem;font-size:1.08rem">{d.summary}</p>
        <div style="margin-bottom:2rem"><span class={`badge ${sev.variant}`}>{sev.label} severity</span> <span class={`badge ${st.variant}`}>{st.label}</span></div>
        <div class="prose"><Content /></div>
      </div>
      <aside class="aside">
        <div class="panel"><h2>Record</h2>
          <dl class="kv">
            <dt>Date</dt><dd>{fmtDate(d.date)}</dd>
            <dt>Severity</dt><dd>{sev.label}</dd>
            <dt>Status</dt><dd>{st.label}</dd>
            <dt>Category</dt><dd>{d.category}</dd>
          </dl>
        </div>
      </aside>
    </div>
  </div>
  <CodeCopy />
</Base>
