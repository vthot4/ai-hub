---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CodeCopy from '../../components/CodeCopy.astro';
import MermaidRender from '../../components/MermaidRender.astro';
import { getOnboarding } from '../../lib/catalog';

export async function getStaticPaths() {
  return (await getOnboarding()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
---
<Base title={d.title} description={d.summary}>
  <div class="container" style="padding-top:2.5rem;max-width:820px">
    <p class="crumbs"><a href="/start/">Start here</a> / {d.title}</p>
    <p class="eyebrow">{d.role} · {d.estimatedTime}</p>
    <h1 style="font-size:clamp(2rem,4vw,2.7rem)"><span aria-hidden="true">{d.icon}</span> {d.title}</h1>
    <p class="muted" style="margin:.8rem 0 2rem;font-size:1.08rem">{d.summary}</p>
    <div class="prose"><Content /></div>
  </div>
  <CodeCopy />
  <MermaidRender />
</Base>
