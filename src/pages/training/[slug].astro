---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CodeCopy from '../../components/CodeCopy.astro';
import { getTraining } from '../../lib/catalog';
import { levelLabel, formatLabel, trainingKindLabel, fmtDate } from '../../lib/labels';

export const prerender = false;

// Solo se usa en la demo estática (todo prerenderizado); el servidor real lo ignora.
export async function getStaticPaths() {
  return (await getTraining()).map((e) => ({ params: { slug: e.id } }));
}

const entry = await getEntry('training', Astro.params.slug!);
if (!entry) return new Response(null, { status: 404 });
const d = entry.data;
const lvl = levelLabel[d.level];
const { Content } = await render(entry);
const today = new Date();
today.setUTCHours(0, 0, 0, 0);
const sessions = [...d.sessions].sort((a, b) => +a - +b);
const nextIdx = sessions.findIndex((s) => +s >= +today);
---
<Base title={d.title} description={d.summary}>
  <div class="container" style="padding-top:2.5rem">
    <p class="crumbs"><a href="/training/">Training</a> / {d.title}</p>
    <div class="detail">
      <div>
        <p class="eyebrow">{trainingKindLabel[d.kind]}</p>
        <h1 style="font-size:clamp(2rem,4vw,2.7rem)"><span aria-hidden="true">{d.icon}</span> {d.title}</h1>
        <p class="muted" style="margin:.8rem 0 1.2rem;font-size:1.08rem">{d.summary}</p>
        <div style="margin-bottom:2rem"><span class={`badge ${lvl.variant}`}>{lvl.label}</span> <span class="badge plain">{formatLabel[d.format]}</span></div>
        <div class="prose"><Content /></div>
      </div>
      <aside class="aside">
        <div class="panel"><h2>Details</h2>
          <dl class="kv">
            <dt>Level</dt><dd>{lvl.label}</dd>
            <dt>Format</dt><dd>{formatLabel[d.format]}</dd>
            <dt>Duration</dt><dd>{d.duration}</dd>
            <dt>For</dt><dd>{d.audience}</dd>
          </dl>
          {d.url && <a class="btn primary" style="margin-top:1rem;width:100%" href={d.url} rel="noopener" target="_blank">Enrol ↗</a>}
        </div>
        <div class="panel"><h2>Sessions</h2>
          {sessions.length === 0 ? <p class="muted">On demand.</p> : (
            <div class="sessions">
              {sessions.map((s, i) => <span class={`session ${i === nextIdx ? 'next' : ''}`} style={+s < +today ? 'opacity:.5;text-decoration:line-through' : ''}>{fmtDate(s)}</span>)}
            </div>
          )}
        </div>
      </aside>
    </div>
  </div>
  <CodeCopy />
</Base>
